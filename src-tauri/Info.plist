<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bundle Identification -->
    <key>CFBundleName</key>
    <string>noFriction</string>
    
    <key>CFBundleDisplayName</key>
    <string>noFriction</string>
    
    <key>CFBundleIdentifier</key>
    <string>com.nofriction.meetings</string>
    
    <!-- CFBundleShortVersionString comes from tauri.conf.json "version";
         CFBundleVersion from bundle.macOS.bundleVersion (scripts/release-mas.sh
         sets a unique build number per App Store upload). Don't hardcode them
         here: this file overrides the generated values. -->
    
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    
    <!-- Executable name must match Cargo package name -->
    <key>CFBundleExecutable</key>
    <string>nofriction-meetings</string>
    
    <!-- System Requirements -->
    <key>LSMinimumSystemVersion</key>
    <string>12.3</string>
    
    <!-- Display Options -->
    <key>NSHighResolutionCapable</key>
    <true/>
    
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    
    <!-- Application Type -->
    <!-- Set to false to show in Dock; true for menu bar only -->
    <key>LSUIElement</key>
    <false/>
    
    <!-- Privacy Permission Descriptions (required by macOS) -->
    
    <!-- Sync with your iPhone (docs/SYNC.md): device to device on the local network -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>noFriction syncs your recordings with noFriction on your iPhone directly over your local network when you turn on Sync. Nothing goes through a server.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_nofriction._tcp</string>
    </array>

    <!-- Microphone - for transcription -->
    <key>NSMicrophoneUsageDescription</key>
    <string>noFriction needs microphone access to transcribe what is said while you record.</string>
    
    <!-- Screen Recording - for system audio and screen capture -->
    <key>NSScreenCaptureUsageDescription</key>
    <string>noFriction needs screen recording access to capture the screens you choose and the audio of other people on a call.</string>
    
    <!-- Calendar - for meeting detection -->
    <key>NSCalendarsUsageDescription</key>
    <string>noFriction needs calendar access to name meetings and list who attended.</string>
    
    <!-- Calendar Full Access (macOS 14+) -->
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>noFriction needs calendar access to name meetings and list who attended.</string>
    
    <!-- App Store (m10): no non-exempt encryption (only HTTPS/TLS from the
         OS), so export compliance is answered automatically. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>

    <!-- URL Schemes (optional) -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>nofriction</string>
            </array>
            <key>CFBundleURLName</key>
            <string>com.nofriction.meetings</string>
        </dict>
    </array>
    
</dict>
</plist>
