  "explainers": [
    {
      "id": "l2-x1",
      "title": "A boundary that chooses",
      "conceptIds": [
        "c3",
        "c4"
      ],
      "caption": "",
      "a11yState": null,
      "kind": "text",
      "data": {
        "paragraphs": [
          "The cell membrane is the boundary of every cell. It keeps the inside in and decides what comes through.",
          "As the instructor put it, the membrane is less a wall than a doorman."
        ]
      }
    },
    {
      "id": "l2-x2",
      "title": "Heads out, tails in",
      "conceptIds": [
        "c3",
        "c4"
      ],
      "caption": "",
      "a11yState": null,
      "kind": "text",
      "data": {
        "paragraphs": [
          "Each phospholipid has a water-loving head and two water-fearing tails.",
          "In water they line up in two layers, heads facing the water on both sides and tails hidden in the middle."
        ]
      }
    }
  ],
  "workedExamples": [
    {
      "id": "l2-w1",
      "prompt": "Oxygen is small and nonpolar. Does it need a protein to cross the membrane?",
      "conceptIds": [
        "c3",
