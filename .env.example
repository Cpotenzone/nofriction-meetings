# noFriction Meetings - Environment Configuration
# Copy this to .env and fill in your actual values
#
# REQUIRED: At minimum you need a transcription API key to use the app.
# All other services are optional and enable additional features.

# ─── TRANSCRIPTION (at least one required) ───────────────────────────
# Deepgram: Primary transcription provider (recommended)
DEEPGRAM_API_KEY=your-deepgram-api-key

# Gemini: Alternative transcription provider
GEMINI_API_KEY=your-gemini-api-key

# ─── AI / LLM (optional, enables AI chat & insights) ─────────────────
# TheBrain Cloud or compatible OpenAI-style API
VLM_BASE_URL=https://your-llm-endpoint.example.com
VLM_BEARER_TOKEN=your-bearer-token
THEBRAIN_EMAIL=your-email@example.com
THEBRAIN_PASSWORD=your-password

# ─── KNOWLEDGE BASE (optional, enables semantic search) ──────────────
# Supabase: Cloud storage for cross-device sync
SUPABASE_CONNECTION_STRING=postgresql://postgres.[project-id]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Pinecone: Vector database for semantic search
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_HOST=your-index-name-abc123.svc.pinecone.io
PINECONE_NAMESPACE=default

# ─── INTELLIGENCE PIPELINE (optional) ────────────────────────────────
REMOTE_INTELLIGENCE_ENABLED=false
REMOTE_INTELLIGENCE_URL=
REMOTE_INTELLIGENCE_TOKEN=
