# noFriction Meetings - Environment Configuration
# Copy this to .env and fill in values ONLY for optional cloud add-ons.
#
# NOTHING here is required. Out of the box the app runs fully local:
#   - Transcription: on-device Whisper (download a model in Settings)
#   - AI chat/insights/frame analysis: local Ollama (http://localhost:11434)
#   - Storage & search: local SQLite (FTS5)

# ─── OPTIONAL: cloud transcription providers ─────────────────────────
# DEEPGRAM_API_KEY=your-deepgram-api-key
# GEMINI_API_KEY=your-gemini-api-key

# ─── OPTIONAL: remote AI endpoint (Ollama-compatible API) ────────────
# Unset = local Ollama. Point at a remote host to offload inference.
# VLM_BASE_URL=https://your-ollama-compatible-endpoint.example.com
# VLM_BEARER_TOKEN=your-bearer-token

# ─── OPTIONAL: cloud knowledge base ──────────────────────────────────
# Supabase: cloud storage for cross-device sync
# SUPABASE_CONNECTION_STRING=postgresql://postgres.[project-id]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Pinecone: vector database for semantic search (local FTS5 used otherwise)
# PINECONE_API_KEY=your-pinecone-api-key
# PINECONE_INDEX_HOST=your-index-name-abc123.svc.pinecone.io
# PINECONE_NAMESPACE=default

# ─── OPTIONAL: intelligence pipeline ─────────────────────────────────
REMOTE_INTELLIGENCE_ENABLED=false
REMOTE_INTELLIGENCE_URL=
REMOTE_INTELLIGENCE_TOKEN=
